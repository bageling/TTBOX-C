[Unit]
Description=TTBOX Web Plugin
After=local-fs.target
# 不 Wants ttbox-core：TTBOX core 需独占 HDMI RX，按需手动启动
# StartLimit* 属于 [Unit] 段：写成 [Service] 会被 systemd 忽略（实测报
# "Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring"），
# 导致失败重启无限刷（板端曾 82 次/31 分钟）。
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
# 运行用户（T02 方案 A）：与 Core 同组 ttbox，方可连接 /run/ttbox/core.sock（0660）
User=ttbox
Group=ttbox
# 路径说明（DEP-06 / design §B1.1 设计决策，2026-09-16 更新）：
# 旧注释称"Web 是插件、不属于 release 产物"，那是 current 下没有 plugins/ 时的
# 止血修复（否则 ExecStart 203/EXEC）。根因（无人浇筑 current 软链）由 DEP-06 解决后，
# 正确终态是【全部运行树进 release，含 plugins】：/opt/ttbox/current -> releases/<ver>/，
# 该树内包含 plugins/web。这样 OTA/回滚对 Web 也原子生效。过渡期由发布脚本
# `ln -sfn current/plugins /opt/ttbox/plugins` 保证旧路径兼容。
WorkingDirectory=/opt/ttbox/current/plugins/web
# ★ Web 后端切换开关（C++ 迁移回滚预案，方案 §7）：cpp=新 C++ 服务（V1.0.47 起默认基线），py=旧 Flask。
#   回滚：改回 py + restart，无需重建代码（Python 入口/lib/static/templates 全程原样保留）。
Environment=TTBOX_WEB_BACKEND=cpp
# ExecStart 依据上面开关选择后端。$$ 是转义，让 /bin/sh 读到 $TTBOX_WEB_BACKEND；
# 用 exec 替换 shell 进程，systemd 才能正确跟踪服务主进程（Type=simple）。
#   · py 路径沿用现役 bin/ttbox-web shim（内部 exec python3 .../ttbox-web.py）；
#   · cpp 路径指向 C++ 二进制 /opt/ttbox/current/bin/ttbox_web（core/CMakeLists.txt 的 target）。
ExecStart=/bin/sh -c 'if [ "$$TTBOX_WEB_BACKEND" = "cpp" ]; then exec /opt/ttbox/current/bin/ttbox_web; else exec /opt/ttbox/current/plugins/web/bin/ttbox-web; fi'
Environment=TTBOX_ROOT=/opt/ttbox/current/plugins/web
# 注意：PYTHONPATH 只需插件根目录（现随 release 走：current/plugins/web）。
# 否则 `from framework_api import ...` 找不到模块。
# 严禁把 /opt/ttbox 放进来：TTBOX 根下的平台层包**现名 ttbox_platform/**
# （2026-10-01 P3 由 platform/ 改名而来）。**不要把名字改回 platform/** ——
# 那个名字与 Python 标准库 `platform` 同名，一旦进 PYTHONPATH（优先级高于 stdlib），
# `import platform` 会解析到它 → werkzeug 启动即崩
#   AttributeError: module 'platform' has no attribute 'system'
# TTBOX 根目录（现为 current/，含 framework/ ttbox_motion/ ttbox_platform/）由
# ttbox-web.py 内部 sys.path.append() 补进末尾（stdlib 优先）。
Environment=PYTHONPATH=/opt/ttbox/current/plugins/web
# IPC socket 唯一真源（A-PATH-5）：与 Core 的 --ipc 及 core/src/common/Paths.hpp::kIpcSocketDefault
# 保持一致（值 = /run/ttbox/core.sock；跨语言同值由 scripts/ttbox_conventions_gate.sh 断言）。
Environment=TTBOX_IPC_SOCKET=/run/ttbox/core.sock
# V-04：模型库根与 Core 的 model_registry_root 对齐（/var/lib/ttbox/models）。
# 缺省 /opt/ttbox/models 是旧布局且 root:root 不可写，会导致上传 500。
Environment=TTBOX_MODELS_ROOT=/var/lib/ttbox/models
# ★ V-20 根治式删除：原 `Environment=TTBOX_WEB_HOST/PORT` 是**装饰性 env**——web 控制台
# 监听地址/端口在源码 plugins/web/bin/ttbox-web.py（LISTEN_HOST/LISTEN_PORT）里定死，
# 改这两行**不会生效**，只会在排障时误导。故删除（不是注释保留）。
# 端口真源 = plugins/web/lib/paths.py::WEB_PORT_DEFAULT（改端口 = 改源码后重部署）。
Environment=TTBOX_PREVIEW_URL=http://127.0.0.1:8001
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
