[Unit]
Description=TTBOX Core (C++)
# ★ V1.0.27：必须**排在 usb-proxy 之后** —— PhysicalMouseReader 连的是 usb-proxy 建的
#   /run/ttbox-mouse-passthrough/event.sock；两者同秒启动时 core 会先连、拿到 ENOENT。
#   （core 侧已加 3.6s 重试兜底，这里是第二道保险：让顺序本身就正确。）
After=systemd-modules-load.service ttbox-usbproxy.service
Wants=systemd-modules-load.service ttbox-usbproxy.service
# StartLimit* 属于 [Unit] 段：写成 [Service] 会被 systemd 忽略
# （实测报 "Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring"），
# 限流一旦失效，失败时就会无限重启（现场曾 82 次/31 分钟）。
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
# 运行身份：root 用户 + ttbox 组。
#   组必须是 ttbox：socket 建出来是 <uid>:<gid> 0660，同组 Web/预览才能连。
#   用户仍是 root：2026-09-16 板端实测，改成 User=ttbox 后两项硬件能力直接失效——
#     · 风扇控制不可用（PWM 节点 /sys/class/hwmon/*/pwm1，编号运行期解析）→ 丢了满转，热节流掉帧
#     · CPU 调频失败（写 /sys/.../cpufreq/policy*/scaling_min_freq Permission denied）
#   这两处 sysfs 节点不支持 chgrp，非 root 无法写；要彻底降权需先补 udev 规则，
#   见 docs 待办。在那之前保持 root，但已消除旧"root + /tmp socket 0666 全局可写"的风险：
#   目录 /run/ttbox 0750 + socket 0660，仅 root 与 ttbox 组可访问。
User=root
Group=ttbox
# /run/ttbox（tmpfs）：core.sock 所在，重启自动清理，属主 ttbox:ttbox
RuntimeDirectory=ttbox
RuntimeDirectoryMode=0750
# /var/lib/ttbox：模型/HID 包等客户数据（FHS，升级绝不触碰）
StateDirectory=ttbox
StateDirectoryMode=0750
# 配置分层（T01）：--config 指向目录 = config.d 深合并（00-factory ← 10-device）
ExecStart=/opt/ttbox/current/bin/ttbox_core_main --config /etc/ttbox/config.d --ipc /run/ttbox/core.sock
WorkingDirectory=/opt/ttbox/current
# 重启限流见 [Unit] 段的 StartLimitBurst / StartLimitIntervalSec。
Restart=always
RestartSec=10
# 动态库来源（DEP-06 / design §B1.4）：出货二进制以自包含 RUNPATH=$ORIGIN/../lib 编译，
# 设备专有库（librknnrt.so 等）随版本落在 releases/<ver>/lib/，由 RUNPATH 就近解析。
# 【已删除】原 Environment=LD_LIBRARY_PATH=/opt/ttbox/current/lib —— 板端实测该目录为空，
# 纯装饰且误导（任何人按字面往 current/lib 补 .so 行为才会改变）。自包含 RUNPATH 后不再需要。
# IPC socket 唯一真源（供排障工具/子进程直接读取）
Environment=TTBOX_IPC_SOCKET=/run/ttbox/core.sock

[Install]
WantedBy=multi-user.target
