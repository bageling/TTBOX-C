          "next_kind": "flow"
        },
        {
          "lane": "out",
          "text": "坐标变换域：像素坐标 ↔ 设备计数",
          "next_label": "缺按键源则拒绝注入",
          "next_kind": "flow"
        },
        {
          "lane": "out",
          "text": "两个后端都必须绑「物理按键源」，缺按键源就拒绝注入（防误注入）",
          "next_label": "回到控制面应答",
          "next_kind": "reply"
        }
      ]
    },
    {
      "label": "四、命令回去",
      "steps": [
        {
          "lane": "ctrl",
          "text": "IPC 服务端把状态变化回给面板（面板的启动/停止按钮即打在「运行控制」命令上）",
          "next_label": "统一日志与配置",
          "next_kind": "flow"
        },
        {
          "lane": "orch",
          "text": "跨层支撑：common 域日志分三个文件落盘 —— 全量流水 12 小时轮转 / 只收最高两级报错直写并刷盘永不被轮转吃掉 / 记客户操作",
          "next_label": "配置分层合并",
          "next_kind": "flow"
        },
        {
          "lane": "orch",
          "text": "其余支撑域：config 配置分层合并 / auth 本地与云端授权校验 / hid USB 设备层（控制器名运行时解析，不写死编号）/ fan 风扇 PWM 控制"
        }
      ]
    }
  ]
