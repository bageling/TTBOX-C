      "steps": [
        {
          "lane": "ctrl",
          "text": "IPC 服务端：面板通过 Unix 域套接字 /run/ttbox/core.sock 发命令，共16 条（状态查询/ 配置写入 / 运行控制 / 模型管理 / 授权）",
          "next_label": "读运行配置",
          "next_kind": "flow"
        },
        {
          "lane": "ctrl",
          "text": "运行配置真源：配置分层合并后的结果，产出「功能门 gates + 数值参数」",
          "next_label": "按门决定启停",
          "next_kind": "flow"
        }
      ]
    },
    {
      "label": "二、按五步固定顺序装配",
      "steps": [
        {
          "lane": "orch",
          "text": "统一生命周期 CoreRuntime：线程全归它管，五步顺序是硬约束",
          "next_label": "① 采集层起帧",
          "next_kind": "flow"
        },
        {
          "lane": "data",
          "text": "① 采集：V4L2Capture 从摄像头取帧，DMA-BUF 零拷贝缓冲区池",
          "next_label": "② 拉起推理线程",
          "next_kind": "flow"
        },
        {
          "lane": "data",
          "text": "② 推理：WorkerPool 多线程跑 NPU（Rknn 引擎加载并执行模型）—— 仅当功能门允许推理，关掉就不起",
          "next_label": "③ 鼠标透传通道",
          "next_kind": "flow"
        },
        {
          "lane": "data",
          "text": "③ 鼠标透传通道 PhysicalMouseReader 启动 —— 红线段：与 AI 授权无关，恒启动，失败只告警不阻塞流水线",
          "next_label": "④ 瞄准线程",
          "next_kind": "flow"
        },
        {
          "lane": "data",
          "text": "④ 瞄准线程 AimThread：主循环做坐标转换 + PID 控制 —— 仅当功能门允许瞄准，关掉就不起",
          "next_label": "⑤ 预览",
          "next_kind": "flow"
        },
        {
          "lane": "data",
          "text": "⑤ 受限预览 PreviewModule：帧率封顶值由上层算好传入",
          "next_label": "三、数据往下走",
          "next_kind": "flow"
        }
      ]
    },
    {
      "label": "三、一帧数据的实际流向",
      "steps": [
        {
          "lane": "data",
          "text": "采集分支把帧交给推理分支（RGA 硬件加速做色彩空间与缩放转换）",
          "next_label": "推理结果交瞄准",
          "next_kind": "flow"
        },
        {
          "lane": "data",
          "text": "推理分支把检测结果交给瞄准分支（Pipeline 做前后处理：预处理 / 后处理 / 选靶）",
          "next_label": "算移动量",
          "next_kind": "flow"
        },
        {
          "lane": "out",
          "text": "输出抽象 IOutputBackend 两种物理设备协议实现：本地 USB HID 直出 / 外接 AI 盒兜底后端",
