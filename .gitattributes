# ============================================================
# TTBOX .gitattributes — 行尾策略
# 板端是 Linux(RK3588)，所有脚本/systemd 必须 LF。
# Windows 工作区 checkout 时禁止转 CRLF，否则 scp 会把 \r 带上板导致
# shebang 错误 ("/usr/bin/env: 'bash\r': No such file or directory")。
# ============================================================

# 所有文本文件统一 LF
* text=auto eol=lf

# 明确强制 LF 的关键类型
*.sh        text eol=lf
*.py        text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.h         text eol=lf
*.c         text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.service   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.txt       text eol=lf
*.cmake     text eol=lf
CMakeLists.txt text eol=lf

# 可执行脚本无扩展名（bin/ 下的 launcher）
plugins/web/bin/*       text eol=lf
plugins/preview/bin/*   text eol=lf

# 二进制绝对不允许行尾处理
*.rknn  binary
*.so    binary
*.a     binary
*.onnx  binary
*.pt    binary
*.bin   binary