# ---------- 本地 Windows 宿主构建（第一阶段验证）----------
/build-win-host/
core/third_party/onnxruntime/lib/
.venv-win/
.wheels/
build-win*/

# ONNX Runtime 本地二进制与下载缓存
core/third_party/onnxruntime/lib/
ort.nupkg

# ---------- T1.11 OTA：私钥永不入库（§0.3 硬红线）----------
# 只有 tools/ota/keys/*.pub（公钥）入库；私钥目录整体排除。
tools/ota/.testkeys/
tools/ota/**/*.priv.pem
*.priv.pem

# ---------- M2.01 License：私钥永不入库（同 §0.3 纪律，密钥分族）----------
# 公钥两处入库：tools/license/keys/*.pub.hex + core 内嵌（LicenseKeys.hpp）。
tools/license/.testkeys/

# ---------- host 构建目录（本轮对标实测自建）----------
/build-host-yu/

# ---------- M2.07.1 防复发：真实云端凭据落点（真值严禁入库）----------
# 背景：T1 收敛密钥泄露面——生产 app_secret / tunnel URL 曾被硬编码进源码与
# config/cloud.example.json。真值唯一落点 = 板端 /opt/ttbox/config/default.json 与
# 本地密钥库。此处显式拦截“真实凭据文件”落点（example 占位符文件仍入库，勿一锅端）。
# 注：config/cloud.local.json 亦被上方 `*.local.json` 覆盖，此处显式列出以表明意图。
/config/cloud.json
/config/cloud.local.json

# ---------- M2.07.1：AI 会话目录（非产品产物，不入库）----------
# .workbuddy/ 是 AI 助手的会话工作目录：
#   · qa_*.txt  = 探针/命令输出抓取物（临时，无长期价值）；
#   · memory/*.md = AI 会话记忆（含板端/会话细节，且会持续累积敏感信息）。
# 二者均无构建/运行价值，入库会污染“可复现出货基线”，并带来信息外泄面（本仓库会
# 交付客户）⇒ 整体忽略（真值已在 memory 内脱敏，此处只是不入库）。
/.workbuddy/

# ---------- M2.07 会话脚手架（AI 探针/部署抓取产物，不入库）----------
# 背景：本轮板端部署与验收过程中，工程师在**仓库根**落了 40 个 `_*.txt` / `_*.sh` /
# `_payload141.tgz` 形临时抓取（命令输出快照、payload 包）。它们无长期价值，
# 但既未被旧规则覆盖 ⇒ 一旦 `git add -A` 会被整体带进库。
# 规则**根锚定 + 限定扩展名**（勿写成裸 `_*`：那会连 `**/__init__.py` 一起吞掉）。
/_*.txt
/_*.sh
/_*.tgz

# ---------- F11② 部署期产物：构建机注入的 git sha（板端落盘，不入库）----------
# 由部署驱动从构建机 `git rev-parse HEAD` 写入板端源码副本根（配合 ttbox_fhs_init.sh
# gen_manifest 的分层解析）；本地误落亦不入库。
/.git_sha

# ---------- 代码梳理（2026-09-17）：本机产物归档区（不入库）----------
# 批次 0/1/4 依据 docs/handover/2026-09-17/代码梳理方案-2026-09-17.md §4.1：
# 将判为「删除/出清」的本机产物（39 个根 _* 探针、陈旧 build 目录、空 models/、
# __pycache__/.pytest_cache 缓存）**移入**本目录而非 rm，供业主复核后再决定是否真删。
# 本目录名**以点号开头 + 固定日期**，与任何现有规则无交集；写在文件**末尾**（last-match-wins）。
# 自检：`git check-ignore -v .archive-2026-09-17/README.md`（期望命中本行）
/.archive-2026-09-17/

# ---------- 代码梳理（2026-09-18）：本机产物归档区（批次 2，不入库）----------
