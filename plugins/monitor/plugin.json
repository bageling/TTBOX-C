{
  "id": "monitor",
  "name": "TTBOX Monitor",
  "version": "1.0.0",
  "description": "TTBOX Monitor 管理插件",
  "api_version": "1",
  "entry": "bin/ttbox-monitor",
  "type": "builtin",
